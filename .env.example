# Local browser preview. Set FRONTEND_HOST=0.0.0.0 only for an external reverse proxy.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080
# Optional future Gateway on the Compose network; no trailing slash or path.
API_GATEWAY_URL=http://api-gateway:8080

# Authentication: local development settings; actual credentials belong in .env.
PUBLIC_ORIGIN=http://127.0.0.1:8080
AUTH_DB_PASSWORD=local-development-only
MAILPIT_PORT=8025
# Optional administrator bootstrap. No default administrator is created.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

# SMTP for confirmation and recovery emails. Local defaults below are for tests.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@skill-day.test
SMTP_NAME=Навык дня
