{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**remainder}" },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Forwarded" }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "primary": { "Address": "http://auth-service:8080/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HttpClient": { "MaxConnectionsPerServer": 100 }
      }
    }
  }
}
